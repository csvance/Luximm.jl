#!/usr/bin/env bash
# Runic pre-commit hook: format the source tree with Runic and re-stage the result.
#
# Runs `runic --inplace --diff` over `src test docs ci utils` (whichever of those
# directories exist), which covers every tracked .jl file in the repo.
#
# Requires the `runic` CLI (Julia >= 1.12 Pkg app), found via $RUNIC, PATH, or
# the bin/ of each JULIA_DEPOT_PATH entry:
#     julia -e 'using Pkg; Pkg.Apps.add("Runic")'
#
# .git/hooks/ is machine-local and not versioned, so install this script as
# your pre-commit hook in a fresh clone with:
#     cp scripts/pre-commit-runic .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -u

# Pkg apps install into the first depot's bin/, which is often not on PATH.
# An empty depot entry, and the final fallback, mean the default depot ~/.julia.
find_runic() {
    if [ -n "${RUNIC:-}" ]; then echo "$RUNIC"; return; fi
    command -v runic && return
    local depot
    IFS=: read -ra depots <<< "${JULIA_DEPOT_PATH:-}"
    for depot in "${depots[@]}" ""; do
        [ -x "${depot:-$HOME/.julia}/bin/runic" ] && { echo "${depot:-$HOME/.julia}/bin/runic"; return; }
    done
}
runic=$(find_runic)

if [ -z "$runic" ] || [ ! -x "$runic" ]; then
    echo "pre-commit: runic CLI not found on PATH or in any depot bin/; skipping formatting." >&2
    echo "  Install it once with:  julia -e 'using Pkg; Pkg.Apps.add(\"Runic\")'" >&2
    exit 0
fi

# Only pass directories that exist: `runic` errors out on a missing path, which
# would block every commit if a source directory were ever renamed or removed.
dirs=(src test docs ci utils)
targets=()
for d in "${dirs[@]}"; do
    [ -d "$d" ] && targets+=("$d")
done

if [ ${#targets[@]} -eq 0 ]; then
    echo "pre-commit: no source directories found; skipping formatting." >&2
    exit 0
fi

echo "pre-commit: formatting ${targets[*]} with Runic..." >&2
"$runic" --inplace --diff "${targets[@]}"
status=$?

# Re-stage the .jl files the formatter touched so the commit includes the formatted code.
# (git ls-files never errors on empty matches, unlike `git add -u` with an unmatched
# pathspec, so a dir with no .jl files can't silently skip the re-stage.)
git ls-files -m -z -- "${targets[@]}" | grep -z '\.jl$' | xargs -0 -r git add --

exit $status
